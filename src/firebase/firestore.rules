rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAdmin()
        && adminDoc().get('role', 'admin') == 'superadmin';
    }

    function adminOrgId() {
      return adminDoc().get('organizationId', '');
    }

    function adminCanAccessOrganization(orgId) {
      return isSuperAdmin()
        || (isAdmin()
          && adminOrgId() is string
          && adminOrgId().size() > 0
          && adminOrgId() == orgId);
    }

    function adminCanAccessActivityData(data) {
      return isSuperAdmin()
        || (isAdmin()
          && data.organizationId is string
          && data.organizationId.size() > 0
          && data.organizationId == adminOrgId());
    }

    function adminCanAccessActivity(activityId) {
      return adminCanAccessActivityData(parentActivity(activityId));
    }

    function isValidAdminRole(role) {
      return role == 'admin' || role == 'superadmin';
    }

    function isValidUserRole(role) {
      return role == 'user' || role == 'organizer';
    }

    function adminSelfDocUpdateValid() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('organizationId', null)
           == resource.data.get('organizationId', null)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['email', 'displayName', 'updatedAt']);
    }

    function adminDocWriteValid() {
      return request.resource.data.organizationId is string
        && request.resource.data.organizationId.size() > 0
        && isValidAdminRole(request.resource.data.get('role', 'admin'));
    }

    function userAdminResolvedRole() {
      return request.resource.data.get('role', resource.data.get('role', 'user'));
    }

    function userAdminUpdateValid() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'organizerOrganizationId'])
        || (
          isValidUserRole(userAdminResolvedRole())
          && (
            (userAdminResolvedRole() == 'organizer'
              && request.resource.data.get('organizerOrganizationId', null) is string
              && request.resource.data.get('organizerOrganizationId', null).size() > 0
              && (isSuperAdmin()
                || request.resource.data.get('organizerOrganizationId', null) == adminOrgId()))
            || (userAdminResolvedRole() == 'user'
              && request.resource.data.get('organizerOrganizationId', null) == null)
          )
        );
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOrganizer() {
      return userExists()
        && userDoc().role == 'organizer'
        && userDoc().organizerOrganizationId is string
        && userDoc().organizerOrganizationId.size() > 0;
    }

    function organizerOrgId() {
      return userDoc().organizerOrganizationId;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    function authEmailMatches(fieldEmail) {
      return hasVerifiedEmail()
        && request.auth.token.email.lower() == fieldEmail.lower();
    }

    function userPrivilegedFieldsUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('organizerOrganizationId', null)
           == resource.data.get('organizerOrganizationId', null);
    }

    function activityOrgIdUnchanged() {
      return request.resource.data.organizationId == resource.data.organizationId;
    }

    function parentActivity(activityId) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data;
    }

    function parentActivityOrgId(activityId) {
      return parentActivity(activityId).organizationId;
    }

    function isRegisteredForActivity(activityId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/activities/$(activityId)/registrations/$(request.auth.uid));
    }

    function activityCreateAllowedKeys() {
      return [
        'title', 'description', 'date', 'time', 'location', 'organizer', 'category',
        'imageUrl', 'latitude', 'longitude', 'street', 'postalCode', 'city', 'fullAddress', 'address',
        'registrationRequired', 'hasParticipantLimit', 'maxParticipants',
        'membershipRequired', 'membershipOrganization', 'membershipUrl',
        'registrationMethod', 'registrationUrl', 'registrationPhone', 'registrationEmail',
        'isCancelled', 'organizationId', 'createdAt', 'createdByUid',
        'seriesId', 'occurrenceIndex', 'recurrence', 'isRecurrenceException'
      ];
    }

    function activityUpdateAllowedKeys() {
      return [
        'title', 'description', 'date', 'time', 'location', 'organizer', 'category',
        'imageUrl', 'latitude', 'longitude', 'street', 'postalCode', 'city', 'fullAddress', 'address',
        'registrationRequired', 'hasParticipantLimit', 'maxParticipants',
        'membershipRequired', 'membershipOrganization', 'membershipUrl',
        'registrationMethod', 'registrationUrl', 'registrationPhone', 'registrationEmail',
        'isCancelled', 'updatedByUid', 'seriesId', 'occurrenceIndex', 'recurrence', 'isRecurrenceException'
      ];
    }

    function userSelfUpdateAllowedKeys() {
      return [
        'name', 'phone', 'email', 'photoUrl', 'updatedAt', 'platform',
        'fcmToken', 'fcmTokens', 'expoPushToken', 'notificationPreferences'
      ];
    }

    function currentLegalTermsVersion() {
      return '2026-09-07';
    }

    function legalConsentValidOnCreate() {
      return request.resource.data.termsAccepted == true
        && request.resource.data.termsAcceptedAt is timestamp
        && request.resource.data.termsAcceptedVersion == currentLegalTermsVersion();
    }

    function userLegalConsentUnchanged() {
      return !resource.data.keys().hasAny(['termsAccepted', 'termsAcceptedAt', 'termsAcceptedVersion'])
        || (
          request.resource.data.termsAccepted == resource.data.termsAccepted
          && request.resource.data.termsAcceptedAt == resource.data.termsAcceptedAt
          && request.resource.data.termsAcceptedVersion == resource.data.termsAcceptedVersion
        );
    }

    function canReadPhoneIndex(normalizedPhone) {
      return isSignedIn()
        && (
          !exists(/databases/$(database)/documents/phoneIndex/$(normalizedPhone))
          || resource.data.uid == request.auth.uid
        );
    }

    match /phoneIndex/{normalizedPhone} {
      allow read: if canReadPhoneIndex(normalizedPhone);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && !exists(/databases/$(database)/documents/phoneIndex/$(normalizedPhone));
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
             'name', 'email', 'phone', 'photoUrl', 'role', 'createdAt', 'updatedAt',
             'termsAccepted', 'termsAcceptedAt', 'termsAcceptedVersion'
           ])
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'phone', 'phoneNormalized', 'photoUrl', 'role', 'createdAt', 'updatedAt', 'platform',
             'fcmToken', 'fcmTokens', 'expoPushToken', 'notificationPreferences',
             'termsAccepted', 'termsAcceptedAt', 'termsAcceptedVersion'
           ])
        && request.resource.data.role == 'user'
        && legalConsentValidOnCreate();

      allow update: if isOwner(uid)
        && userPrivilegedFieldsUnchanged()
        && userLegalConsentUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userSelfUpdateAllowedKeys());

      allow update: if isAdmin() && userAdminUpdateValid();

      allow delete: if isSuperAdmin();

      match /security/{docId} {
        allow read, write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isSuperAdmin() && adminDocWriteValid();
      allow update: if isSuperAdmin()
        || (isAdmin() && isOwner(uid) && adminSelfDocUpdateValid());
      allow delete: if isSuperAdmin();
    }

    match /organizations/{organizationId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if adminCanAccessOrganization(organizationId);
      allow delete: if isSuperAdmin();
    }

    match /organizerApplications/{applicationId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && hasVerifiedEmail()
        && request.resource.data.applicantUid == request.auth.uid
        && authEmailMatches(request.resource.data.email)
        && request.resource.data.status == 'Ny'
        && request.resource.data.keys().hasAll([
             'name', 'email', 'phone', 'organization', 'description',
             'createdAt', 'status', 'applicantUid'
           ])
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'phone', 'organization', 'description',
             'createdAt', 'status', 'applicantUid'
           ]);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'organizationId', 'reviewedAt',
             'reviewedByAdminUid', 'rejectionReason'
           ]);

      allow delete: if isAdmin();
    }

    match /organizers/{organizerId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /activities/{activityId} {
      allow read: if true;

      allow create: if isOrganizer()
        && request.resource.data.organizationId == organizerOrgId()
        && request.resource.data.keys().hasAll([
             'title', 'description', 'date', 'time', 'location', 'organizer',
             'category', 'organizationId'
           ])
        && request.resource.data.keys().hasOnly(activityCreateAllowedKeys());

      allow update: if isOrganizer()
        && resource.data.organizationId == organizerOrgId()
        && request.resource.data.organizationId == organizerOrgId()
        && activityOrgIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(activityUpdateAllowedKeys());

      allow delete: if isOrganizer()
        && resource.data.organizationId == organizerOrgId();

      allow create: if isAdmin() && adminCanAccessActivityData(request.resource.data);
      allow update: if isAdmin()
        && adminCanAccessActivityData(resource.data)
        && adminCanAccessActivityData(request.resource.data)
        && (isSuperAdmin() || activityOrgIdUnchanged());
      allow delete: if isAdmin() && adminCanAccessActivityData(resource.data);

      match /registrations/{registrationId} {
        allow read: if
          (isSignedIn() && registrationId == request.auth.uid)
          || (isOrganizer() && parentActivityOrgId(activityId) == organizerOrgId())
          || (isAdmin() && adminCanAccessActivity(activityId));

        // Bookings are created only via the bookActivityRegistration Cloud Function (Admin SDK).
        allow create: if false;

        allow update: if isSignedIn()
          && registrationId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelledAt'
             ])
          && request.resource.data.status == 'cancelled'
          && resource.data.status in ['registered', 'waitlist'];

        allow update: if isAdmin() && adminCanAccessActivity(activityId);
        allow delete: if isAdmin() && adminCanAccessActivity(activityId);
      }

      match /announcements/{announcementId} {
        allow read: if isSignedIn() && (
          (isAdmin() && adminCanAccessActivity(activityId))
          || (isOrganizer() && parentActivityOrgId(activityId) == organizerOrgId())
          || isRegisteredForActivity(activityId)
        );

        allow create, update, delete: if isOrganizer()
          && parentActivityOrgId(activityId) == organizerOrgId();

        allow create, update, delete: if isAdmin()
          && adminCanAccessActivity(activityId);
      }

      match /reminderDeliveries/{deliveryId} {
        allow read, write: if false;
      }
    }
  }
}
