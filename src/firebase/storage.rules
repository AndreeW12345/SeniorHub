rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isOrganizer() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().role == 'organizer'
        && userDoc().organizerOrganizationId is string
        && userDoc().organizerOrganizationId.size() > 0;
    }

    function organizerOrgId() {
      return userDoc().organizerOrganizationId;
    }

    function adminOrgId() {
      return firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.organizationId;
    }

    function activityBelongsToOrganizer(activityId) {
      return firestore.exists(/databases/(default)/documents/activities/$(activityId))
        && firestore.get(/databases/(default)/documents/activities/$(activityId)).data.organizationId
           == organizerOrgId();
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Activity cover images for existing activities — scoped to organizer's organization.
    match /activities/{activityId}/cover.jpg {
      allow read: if true;
      allow write: if isValidImageUpload() && (
        isAdmin()
        || (isOrganizer() && activityBelongsToOrganizer(activityId))
      );
    }

    // Temporary uploads before an activity id exists (organizer/admin only).
    match /activities/{fileName} {
      allow read: if true;
      allow write: if isValidImageUpload() && (isAdmin() || isOrganizer());
    }

    // Profile avatars — user uploads own photo from profil/edit.
    match /profiles/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isValidImageUpload()
        && isSignedIn()
        && request.auth.uid == userId
        && fileName == 'avatar.jpg';
    }

    // Organization logos — admin org page; scope admin to own org.
    match /organizations/{organizationId}/{fileName} {
      allow read: if true;
      allow write: if isValidImageUpload()
        && fileName == 'logo.jpg' && (
        (isAdmin() && adminOrgId() == organizationId)
        || (isOrganizer() && organizerOrgId() == organizationId)
      );
    }
  }
}
