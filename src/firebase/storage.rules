rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAdmin()
        && adminDoc().get('role', 'admin') == 'superadmin';
    }

    function adminOrgId() {
      return adminDoc().get('organizationId', '');
    }

    function adminCanAccessOrganization(orgId) {
      return isSuperAdmin()
        || (isAdmin()
          && adminOrgId() is string
          && adminOrgId().size() > 0
          && adminOrgId() == orgId);
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isOrganizer() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().role == 'organizer'
        && userDoc().organizerOrganizationId is string
        && userDoc().organizerOrganizationId.size() > 0;
    }

    function organizerOrgId() {
      return userDoc().organizerOrganizationId;
    }

    function activityExists(activityId) {
      return firestore.exists(/databases/(default)/documents/activities/$(activityId));
    }

    function activityOrganizationId(activityId) {
      return firestore.get(/databases/(default)/documents/activities/$(activityId)).data.organizationId;
    }

    function activityBelongsToOrganizer(activityId) {
      return activityExists(activityId)
        && activityOrganizationId(activityId) == organizerOrgId();
    }

    function activityBelongsToAdmin(activityId) {
      return activityExists(activityId)
        && adminCanAccessOrganization(activityOrganizationId(activityId));
    }

    function canUploadActivityCover(activityId) {
      return isValidImageUpload() && (
        (isOrganizer() && activityBelongsToOrganizer(activityId))
        || (isAdmin() && activityBelongsToAdmin(activityId))
      );
    }

    function canUploadTemporaryActivityImage() {
      return isValidImageUpload() && (
        isOrganizer()
        || (isAdmin()
          && (isSuperAdmin()
            || (adminOrgId() is string && adminOrgId().size() > 0)))
      );
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Activity cover images for existing activities — scoped to organizer/admin organization.
    match /activities/{activityId}/cover.jpg {
      allow read: if true;
      allow write: if canUploadActivityCover(activityId);
    }

    // Temporary uploads before an activity id exists (organizer/admin only).
    match /activities/{fileName} {
      allow read: if true;
      allow write: if canUploadTemporaryActivityImage();
    }

    // Profile avatars — user uploads own photo from profil/edit.
    match /profiles/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isValidImageUpload()
        && isSignedIn()
        && request.auth.uid == userId
        && fileName == 'avatar.jpg';
    }

    // Organization logos — admin org page; scope admin to own org.
    match /organizations/{organizationId}/{fileName} {
      allow read: if true;
      allow write: if isValidImageUpload()
        && fileName == 'logo.jpg' && (
        adminCanAccessOrganization(organizationId)
        || (isOrganizer() && organizerOrgId() == organizationId)
      );
    }
  }
}
