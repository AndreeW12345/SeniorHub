# Local Firebase Functions secrets (emulator only).
# Production secrets are set with:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set MOBILE_AUTH_LINKS_SETUP_SECRET
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Optional function params (firebase functions:config or .env for emulator):
# HOSTING_DOMAIN=your-project.web.app
# ADMIN_EMAIL_ALLOWLIST=admin@example.com
