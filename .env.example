# Firebase configuration for SeniorHub
# Copy this file to .env and fill in the values from Firebase Console.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Deployed Firebase Hosting domain for Magic Link universal / app links.
# Must match the site where Hosting is deployed (Firebase Console → Hosting).
# Example: your-project-id.web.app
EXPO_PUBLIC_FIREBASE_HOSTING_DOMAIN=

# Optional web-only override for ActionCodeSettings.url.
# Native uses https://<EXPO_PUBLIC_FIREBASE_HOSTING_DOMAIN>/auth/complete automatically.
# Do NOT use localhost. Do NOT set linkDomain in code for default *.web.app domains.
# EXPO_PUBLIC_AUTH_CONTINUE_URL=https://seniorhub-se.web.app/auth/complete

# Optional: comma-separated admin emails allowed to bootstrap admin UI (Firestore rules still enforce admins/{uid}).
# EXPO_PUBLIC_ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Firebase App Check (optional until enforced in Firebase Console)
# Web production: register reCAPTCHA v3 site in Firebase Console → App Check
# EXPO_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=
# Native development only — register debug token in Console; never commit the value
# EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Deploy Hosting, then configure Firebase Auth mobile link domain (one-time):
#   firebase functions:secrets:set MOBILE_AUTH_LINKS_SETUP_SECRET
#   firebase functions:secrets:set RESEND_API_KEY  (if not already set)
#   MOBILE_AUTH_LINKS_SETUP_SECRET=your-new-secret npm run configure:mobile-auth-links:remote
#
# IMPORTANT: The old hardcoded secret `seniorhub-mobile-links-setup` was exposed in Git history
# and must NOT be reused. Rotate to a new secret via Secret Manager.
# Paste your Resend API key when prompted (Dashboard → API Keys).
#
# Verify sending domain in Resend before production:
#   noreply@seniorhub.se  (confirmation emails to applicants)
#   arrangor@seniorhub.se (inbox for new applications — receiving only)
#
# Deploy functions + Firestore rules after updating secrets:
#   cd functions && npm run deploy
#   firebase deploy --only firestore:rules
